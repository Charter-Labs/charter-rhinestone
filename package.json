{
  "private": true,
  "scripts": {
    "build": "bun run clean && tsc",
    "clean": "rimraf src/dist",
    "test": "vitest",
    "check": "biome check",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "changeset:release": "bun run build && changeset publish --tag v1-latest",
    "changeset:version": "changeset version && bun run scripts/sync-version.ts",
    "size": "size-limit"
  },
  "workspaces": [
    "./src"
  ],
  "dependencies": {
    "viem": "^2.57.10"
  },
  "overrides": {
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.1.4",
    "@changesets/cli": "^2.31.1",
    "@size-limit/esbuild-why": "^11.2.0",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/bun": "^1.4.3",
    "jose": "^6.2.13",
    "prool": "^0.0.24",
    "rimraf": "^6.1.3",
    "size-limit": "^11.2.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.9",
    "tsc-esm-fix": "^3.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
